# Database (Postgres — Docker Compose local or Neon/Supabase)
DATABASE_URL=postgresql://diffreview:diffreview@localhost:5433/diffreview

# Web / ingest auth
DIFF_REVIEW_INGEST_SECRET=dev-ingest-secret-change-me
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Optional Auth.js (not required for public demo)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub (Action / live mode)
GITHUB_TOKEN=
GITHUB_REPOSITORY=
# App stub (stretch — unused in Action-first v1)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# LLM
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MAX_DIFF_CHARS=80000
MAX_FINDINGS=20

# Action → dashboard
DIFF_REVIEW_API_URL=http://localhost:3001/api/ingest
